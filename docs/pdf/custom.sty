\newcounter{codesource}
\ExplSyntaxOn
\seq_new:N \g_report_code_sources_seq
\NewDocumentCommand{\CollectCodeSource}{mmm}{
  \seq_gput_right:Nx \g_report_code_sources_seq {
    \exp_not:N \CodeSourceIndexEntry {#1} {\exp_not:n{#2}} {\exp_not:n{#3}}
  }
}
\NewDocumentCommand{\PrintCodeSources}{}{
  \seq_use:Nn \g_report_code_sources_seq {}
}
\ExplSyntaxOff

\newcommand{\CodeSourceIndexEntry}[3]{%
  \hypertarget{code-index-#1}{}\hyperlink{code-text-#1}{\textbf{C#1}}
  & \path{#2} & \textbf{#3}\\[2pt]}
\newcommand{\RegisterCodeSource}[2]{%
  \stepcounter{codesource}%
  \edef\CodeSourceNumber{\arabic{codesource}}%
  \hypertarget{code-text-\CodeSourceNumber}{}%
  \CollectCodeSource{\CodeSourceNumber}{#1}{#2}}
\newcommand{\coderef}[2]{%
  \RegisterCodeSource{#1}{#2}%
  \hyperlink{code-index-\CodeSourceNumber}{\textbf{C\CodeSourceNumber}}}

\newenvironment{codefragment}[3]{%
  \par\addvspace{12pt}\noindent\begin{minipage}{\linewidth}%
  \RegisterCodeSource{#2}{#3}%
  \def\CodeSourceFooter{%
    \setlength{\fboxsep}{5pt}%
    \colorbox{codesourcepaper}{%
      \parbox{\dimexpr\linewidth-2\fboxsep\relax}{%
        \raggedright\footnotesize
        \hyperlink{code-index-\CodeSourceNumber}{\textbf{Sursă C\CodeSourceNumber}}%
        \enspace\path{#2}\par
        \textbf{\color{inkblue}Linii #3}}}}%
  {\small\raggedright\textbf{Fragment C\CodeSourceNumber.}\enspace #1\par}%
}{%
  \par\noindent\CodeSourceFooter\par
  \end{minipage}\par\addvspace{14pt}
}

\newcommand{\imagecredit}[1]{\par\smallskip{\footnotesize\raggedright
  \noindent\textit{Imagine din proiect} \enspace #1\par}}