# Keep the Linux build script executable by Bash after a Windows checkout.
*.sh text eol=lf

# Track Windows executables and app-local runtime DLLs through Git LFS.
/exports/builds/windows-x64/*.exe filter=lfs diff=lfs merge=lfs -text
/exports/builds/windows-x64/*.dll filter=lfs diff=lfs merge=lfs -text

# Track heavy media assets (GIFs/PNGs) through Git LFS.
media/**/*.gif filter=lfs diff=lfs merge=lfs -text
media/**/*.png filter=lfs diff=lfs merge=lfs -text
